#!name=NGA 启动加速
#!desc=广告 SDK 的请求不再真实出网，全部在本地立即返回空对象。相比逐个改写应答，省掉 DNS + 连接 + TLS 等待，启动可快 0.5~1 秒。代价是 SDK 拿到的是空对象而非标准「无填充」字段，个别广告位可能改播本地缓存。若只在意去广告、不在意启动速度，请停用本插件、只保留 nga-ad.plugin。
#!author=SydawN
#!homepage=https://github.com/SydawN/loon
#!raw-url=https://github.com/SydawN/loon/raw/main/nga-fast.plugin
#!icon=https://img.nga.cn/favicon.ico
#!category=SydawN 的插件
#!tag = 加速, NGA
#!date=2026-11-22 15:40:00

[Rule]
# 穿山甲：get_ads 实测 698ms、stats/batch 8 次各 130ms，是启动最大瓶颈
DOMAIN, api-access.pangolin-sdk-toutiao.com, REJECT-DICT
DOMAIN, is.snssdk.com, REJECT-DICT

# 优量汇：gdt_mview.fcg 实测 364/371ms
DOMAIN, mi.gdt.qq.com, REJECT-DICT

# 快手联盟：config 实测 24710 字节 / 148ms
DOMAIN, open.e.kuaishou.com, REJECT-DICT

# 一号联盟：实测走 119.29.29.98 自建 DoH 解析后直连 IP，域名规则抓不到
DOMAIN, sdk.1rtb.net, REJECT-DICT
DOMAIN-SUFFIX, 1rtb.net, REJECT-DICT
IP-CIDR, 119.29.29.98/32, REJECT

# 快手图床 / 素材域名：给 1×1 像素，避免 404 被 SDK 判成网络错误
DOMAIN-SUFFIX, a.yximgs.com, REJECT-IMG
DOMAIN-SUFFIX, douyinpic.com, REJECT-IMG
DOMAIN-SUFFIX, iqiyipic.com, REJECT-IMG

[End of file.]
