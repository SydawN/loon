#!name=NGA 去广告
#!desc=拦截优量汇、快手联盟、亿典、mobrtb、百度联盟、京准通、阿里妈妈等广告 SDK 与点击跳转；并把 adfree 字段伪装为已免广告。banner_list / recmd_topic / get_event_app 实测均为官方运营内容，不做改写。
#!author=SydawN
#!homepage=https://github.com/SydawN/loon
#!raw-url=https://github.com/SydawN/loon/raw/main/nga-ad.plugin
#!icon=https://img.nga.cn/favicon.ico
#!category=SydawN 的插件
#!tag = 去广告, NGA
#!date=2026-11-22 13:00:00

[Rule]
# 优量汇素材与联盟角标（实测开屏会加载 ylg_logo.png）
DOMAIN, sigcdn.oss-cn-beijing.aliyuncs.com, REJECT

# 百度联盟点击跳转（实测为 http 明文，无需 MITM）
URL-REGEX, ^http://m\.baidu\.com/baidu\.php, REJECT
DOMAIN-SUFFIX, mobads.baidu.com, REJECT
DOMAIN-SUFFIX, mobads-logs.baidu.com, REJECT
DOMAIN-SUFFIX, cpro.baidu.com, REJECT
DOMAIN-SUFFIX, pos.baidu.com, REJECT
DOMAIN-SUFFIX, cbjs.baidu.com, REJECT
DOMAIN-SUFFIX, union.baidu.com, REJECT
DOMAIN-SUFFIX, eclick.baidu.com, REJECT
DOMAIN-SUFFIX, nsclick.baidu.com, REJECT
DOMAIN-SUFFIX, entry.baidu.com, REJECT
DOMAIN-SUFFIX, hmma.baidu.com, REJECT
DOMAIN-SUFFIX, mtj.baidu.com, REJECT
DOMAIN-SUFFIX, cpro.baidustatic.com, REJECT
DOMAIN-SUFFIX, dup.baidustatic.com, REJECT

# 穿山甲 / 巨量引擎（NGA aid=5000546）
DOMAIN-SUFFIX, pangle.io, REJECT
DOMAIN-SUFFIX, gromore.cn, REJECT
DOMAIN-SUFFIX, oceanengine.com, REJECT
DOMAIN-SUFFIX, pangolin-sdk-toutiao.com, REJECT
DOMAIN-SUFFIX, pglstatp-toutiao.com, REJECT

# 优量汇 / 腾讯广告
DOMAIN-SUFFIX, gdt.qq.com, REJECT
DOMAIN, e.qq.com, REJECT
DOMAIN-SUFFIX, pgdt.gtimg.cn, REJECT
DOMAIN-SUFFIX, adsmogo.com, REJECT
DOMAIN, tid.m.qq.com, REJECT

# mobrtb（实测开屏素材 cdn.mobrtb.com/whale/static/*.jpeg 720x1280）
DOMAIN-SUFFIX, mobrtb.com, REJECT
DOMAIN-SUFFIX, 52qumao.com, REJECT
DOMAIN-SUFFIX, microengine.cn, REJECT

# 亿典广告平台（实测开屏曝光上报 api.ocpx.ydmob.com）
DOMAIN-SUFFIX, ydmob.com, REJECT

# 快手联盟素材（实测 p2/p4.a.yximgs.com/upic/ 下 360x640 广告图，与帖子图同域名同路径，只能整域拦）
DOMAIN-SUFFIX, a.yximgs.com, REJECT
DOMAIN-SUFFIX, open.e.kuaishou.com, REJECT
DOMAIN-SUFFIX, kuaishouzt.com, REJECT

# 京东京准通 / 开普勒
DOMAIN-SUFFIX, jzt.jd.com, REJECT
DOMAIN-SUFFIX, dg.k.jd.com, REJECT
DOMAIN-SUFFIX, orbit.jd.com, REJECT

# 阿里妈妈
DOMAIN-SUFFIX, tanx.com, REJECT
DOMAIN-SUFFIX, alimama.com, REJECT
DOMAIN-SUFFIX, mmstat.com, REJECT

# NGA 实测第三方追踪
DOMAIN-SUFFIX, youku-dsp.youku.com, REJECT
DOMAIN, content-understand-strategy.sm.cn, REJECT
URL-REGEX, ^https://lf-cdn-tos\.bytescm\.com/obj/static/ad/, REJECT

# ================= 2026-11-22 二次抓包新增 =================
# 结论：adfree 已被脚本改写为 1，但广告全在。该字段不控制广告位，只影响「付费会员可免除广告」文案。
# 真实广告链路：美团必吃榜（穿山甲渠道）+ 滴滴（快手联盟 channel）+ 广告星竞价

# 穿山甲 / 巨量素材 CDN（实测开屏与信息流加载 812KB mp3 及图片素材）
DOMAIN-SUFFIX, douyinstatic.com, REJECT
DOMAIN-SUFFIX, ad.toutiao.com, REJECT

# 美团广告曝光监测（campaign_name=美食-必吃榜-付费-联盟ios-图片, mt_channel=jinritoutiao, csite=33013）
DOMAIN-SUFFIX, apimobile.meituan.com, REJECT

# 滴滴广告点击上报（快手联盟渠道，product_id=wycck, UA=kwai-ios, dname=盟耀-站内）
DOMAIN, gungnir.xiaojukeji.com, REJECT
DOMAIN-SUFFIX, ad.partner.gifshow.com, REJECT

# 广告星 adstarcharm 竞价失败上报（price=307 即 eCPM 3.07 元）
DOMAIN-SUFFIX, adstarcharm.com, REJECT

# 微博广告图床（KID=imgbed,ads）
DOMAIN-SUFFIX, ads.sinaimg.cn, REJECT

# 优量汇素材 CDN 补漏
DOMAIN-SUFFIX, gdtimg.com, REJECT

# ---- 2026-11-22 12:42 三次抓包：穿山甲视频素材 + 字节深链 SDK ----

# 穿山甲图片 / 视频素材 CDN（实测 p9-sign.douyinpic.com 返回 MP4 视频流 Lavc58）
DOMAIN-SUFFIX, douyinpic.com, REJECT
DOMAIN-SUFFIX, byteimg.com, REJECT
DOMAIN-SUFFIX, ibytedtos.com, REJECT

# 字节 / 穿山甲 deeplink SDK（UA=oime_iOS 1.6.6 Cronet, app_name=oime, iid=1105421858044119）
# 返回 settings 含 deeplink_domains、deeplink_timeout、pasteboard 配置，纯广告归因与跳转组件
DOMAIN-SUFFIX, ugsdk.cn, REJECT
DOMAIN-SUFFIX, zlinkurl.cn, REJECT

# ---- 京东京准通广告素材 CDN（实测 img1.360buyimg.com/pop/jfs/*.jpg）---
DOMAIN-SUFFIX, 360buyimg.com, REJECT

# ---- 淘宝闪购 / 饿了么 开屏素材库（实测 1080x1920 jpeg，路径 ad-performance-advertiser）---
DOMAIN-SUFFIX, qhzl.com.cn, REJECT

# ---- 优量汇 TMF 归因（注意是 tdid 不是 tid，之前漏了一个 d）---
DOMAIN, tdid.m.qq.com, REJECT
DOMAIN-SUFFIX, tdid.m.qq.com, REJECT
# 腾讯广告管理系统 ams-web（WebView 内加载的 page-performance.js）
DOMAIN-SUFFIX, i.gtimg.cn, REJECT

# ---- 穿山甲曝光上报 tr.byteurl.cn（实测 漫剧单本 项目，ad_platform=toutiao, csite=33013）----
DOMAIN-SUFFIX, byteurl.cn, REJECT

# ---- 腾讯 SSP 竞价上报 tencent-ssp.66mobi.com/Wmrtb/lossNotice.api（loss_action=AUCTION_LOSS）----
# 关掉它等于不让 SDK 完成竞价确认，广告可能拿不到展示授权
DOMAIN-SUFFIX, 66mobi.com, REJECT

# ---- 葵牛广告 SDK sdk1xyajs.data.kuiniuca.com/o_live_p2p_mobilesdk（加密 POST，返回 404）----
DOMAIN-SUFFIX, kuiniuca.com, REJECT

[Script]
# 把 user&__act=detail 响应里的 adfree 改成 1
http-response ^https://ngabbs\.com/app_api\.php script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/nga-adfree.js, requires-body=true, timeout=30, tag=NGA伪装免广告

[MITM]
hostname = ngabbs.com, lf-cdn-tos.bytescm.com, img.nga.cn, img4.nga.cn
