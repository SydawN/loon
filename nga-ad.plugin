#!MANAGED-CONFIG https://raw.githubusercontent.com/SydawN/loon/main/nga-ad.plugin interval=86400

[Plugin]
name=NGA 去广告
desc=静默化 NGA 的开屏横幅、信息流推广帖与活动入口接口，并拦截优酷 DSP、腾讯设备 ID、UC 广告策略、字节 playable 广告 SDK 等追踪域名。
author=SydawN
icon=https://img.nga.cn/favicon.ico
apiVersion=1.0
homepage=https://github.com/SydawN/loon
date=2026-11-22

[Rule]
# ---- 第三方广告追踪（NGA App 内实测抓包）----
DOMAIN-SUFFIX,youku-dsp.youku.com,REJECT
DOMAIN,tid.m.qq.com,REJECT
DOMAIN,content-understand-strategy.sm.cn,REJECT
URL-REGEX,^https://lf-cdn-tos\.bytescm\.com/obj/static/ad/,REJECT

[Script]
nga-ad = type=http-response,pattern=^https://ngabbs\.com/nuke\.php\?__lib=app_inter,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/nga-ad.js

[MITM]
hostname = %APPEND% ngabbs.com, lf-cdn-tos.bytescm.com
