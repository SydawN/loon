#!name=豆瓣去广告 v7
#!desc=v7 零解密版 + 微博开屏：整个插件不含任何 MITM、不含任何脚本，只在策略层拦广告域名和广告接口。豆瓣的登录、账号、内容链路一行都不碰——关掉 Loon 才能登录的那类问题，根源都是 MITM 解密，这一版把它彻底去掉了。v7 补上微博 SDK 的开屏链路（截图确认的最后一条没覆盖的源）。
#!author=SydawN
#!homepage=https://github.com/SydawN/loon
#!raw-url=https://github.com/SydawN/loon/raw/main/douban-ad.plugin
#!icon=https://www.douban.com/favicon.ico
#!category=SydawN 的插件
#!tag = 去广告, 豆瓣
#!date=2026-11-22 19:10:00
#!version=7

[Rule]
# ============ 豆瓣自有广告系统 Dale / Erebor / Amonsul ============
# erebor 只做广告竞价，拦掉安全
DOMAIN, erebor.douban.com, REJECT

# 开屏四件套（splash_bid / preload / show / statistics）
# 策略层直接回 200 + {}，不需要解密，所以 api.douban.com 完全不进 MITM
URL-REGEX, ^https://api\.douban\.com/v2/app_ads/, REJECT-DICT

# 广告图（首页横幅、开屏静态图都在这个路径下）
# 用 REJECT-IMG 回 1×1 像素而不是 404，App 当正常的空图，广告位空白但不报错
URL-REGEX, ^https://img\d+\.doubanio\.com/view/dale-online/, REJECT-IMG

# 首页横幅
URL-REGEX, ^https://frodo\.douban\.com/api/v2/home_banner, REJECT-DICT
# 信息流里插的那条广告
URL-REGEX, ^https://frodo\.douban\.com/api/v2/erebor/feed_ad, REJECT-DICT
# 小组页广告位
URL-REGEX, ^https://frodo\.douban\.com/api/v2/group/[0-9]+/ad, REJECT-DICT

# home_ads 故意不动。它在 14 号包里原样就是 {"cache_duration":7200}，本来就没广告；
# 上一版硬改成空对象丢了 cache_duration，App 判非法缓存指令，整个首页块不渲染。

# ============ 微博 SDK 开屏广告 ============
# 开屏截图确认来源：左上角微博 logo + 「跳过 4」+「扭动手机 跳转详情页面或第三方应用」+ 右下角广告角标。
# 这是微博 SDK 自己的开屏位，跟豆瓣 dale、优量汇、穿山甲都不是同一条链，之前几版全漏了。
# getaid.json 就是微博 SDK 取广告 ID 的入口，只拦这一条 URL，微博登录授权不受影响。
URL-REGEX, ^https://api\.weibo\.com/oauth2/getaid\.json, REJECT
DOMAIN-SUFFIX, ads.sinaimg.cn, REJECT-IMG
DOMAIN-SUFFIX, sax.sina.com.cn, REJECT
DOMAIN-SUFFIX, saxs.sina.com.cn, REJECT

# ============ 广告联盟入口 ============
# 穿山甲（豆瓣 site_id 5003518）
DOMAIN-SUFFIX, pangle.io, REJECT
DOMAIN-SUFFIX, gromore.cn, REJECT
DOMAIN-SUFFIX, oceanengine.com, REJECT

# 优量汇 / 腾讯广告（豆瓣 app id 1106295950）
DOMAIN-SUFFIX, gdt.qq.com, REJECT
DOMAIN-SUFFIX, pgdt.gtimg.cn, REJECT-IMG
# 素材在 ugdtimg 下：pgdt.（静态图）、adsmind.（视频），视频 302 落到 *.rdt.tfogc.com:49156
DOMAIN-SUFFIX, ugdtimg.com, REJECT-IMG
DOMAIN-SUFFIX, rdt.tfogc.com, REJECT

# 快手联盟
DOMAIN-SUFFIX, open.e.kuaishou.com, REJECT
DOMAIN-SUFFIX, kuaishouzt.com, REJECT

# 百度联盟
DOMAIN-SUFFIX, mobads.baidu.com, REJECT
DOMAIN-SUFFIX, mobads-logs.baidu.com, REJECT
DOMAIN-SUFFIX, cpro.baidu.com, REJECT

# 京东京准通
DOMAIN-SUFFIX, jzt.jd.com, REJECT
DOMAIN-SUFFIX, orbit.jd.com, REJECT

# 阿里妈妈
DOMAIN-SUFFIX, tanx.com, REJECT
DOMAIN-SUFFIX, alimama.com, REJECT

[End of file.]
