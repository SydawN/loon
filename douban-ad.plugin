#!name=豆瓣去广告 v19
#!desc=参照 mist-whisper BlockAds 与 fmz200 blockAds 的写法重写：域名走 [Rule] 整域拒绝，接口与素材走 [Rewrite] 的 reject-dict / reject，不用命名式脚本；仅在 feature_switch 上保留一个旧语法 http-response 脚本清空 splash_sdk_info。
#!author=SydawN
#!homepage=https://github.com/SydawN/loon
#!raw-url=https://github.com/SydawN/loon/raw/main/douban-ad.plugin
#!icon=https://www.douban.com/favicon.ico
#!category=SydawN 的插件
#!tag=去广告, 豆瓣
#!date=2026-11-22 23:20:00
#!version=19

[Rule]
# 豆瓣自有广告系统
DOMAIN-SUFFIX, erebor.douban.com, REJECT
DOMAIN-SUFFIX, ad.doubanio.com, REJECT

# 微博 / 新浪系：只保留纯广告与监测域
# api.weibo.com / weibo.com / weibo.cn 是微博主 API 与 H5 主域
# wbimg.cn / weibocdn.com / sinaimg.cn 是微博图床与视频 CDN
# Loon 的 [Rule] 全设备生效，整域 REJECT 会让微博首页、刷新、图片全空
DOMAIN-SUFFIX, sinaads.sina.com.cn, REJECT
DOMAIN-SUFFIX, sax.sina.com.cn, REJECT
DOMAIN-SUFFIX, saxs.sina.com.cn, REJECT
DOMAIN-SUFFIX, beacon.sina.com.cn, REJECT

# 优量汇 / 腾讯广告
DOMAIN-SUFFIX, gdt.qq.com, REJECT
DOMAIN-SUFFIX, pgdt.gtimg.cn, REJECT
DOMAIN-SUFFIX, ugdtimg.com, REJECT
DOMAIN-SUFFIX, rdt.tfogc.com, REJECT
DOMAIN-SUFFIX, gdtimg.com, REJECT

# 穿山甲 / 巨量
DOMAIN-SUFFIX, pangle.io, REJECT
DOMAIN-SUFFIX, gromore.cn, REJECT
DOMAIN-SUFFIX, oceanengine.com, REJECT
DOMAIN-SUFFIX, pangolin-sdk-toutiao.com, REJECT
DOMAIN-SUFFIX, pangolin-sdk-toutiao1.com, REJECT
DOMAIN-SUFFIX, pangolin-sdk-toutiao-b.com, REJECT
# 下面这些是字节的公共 CDN / 调度域，不是穿山甲专属广告域，整域 REJECT 会误伤抖音：
#   douyinvod.com    抖音视频分发（v3-dy-o.douyinvod.com 等），封了直接转圈不出画面
#   douyinpic.com    抖音封面 / 头像图床，封了封面空白
#   pstatp.com       字节公共 CDN，抖音图片与部分静态资源也走它
#   zijieapi.com     字节域名调度服务，抖音启动时也会请求
#   mssdk.volces.com 火山 MediaSDK，播放器相关
# Loon 的 [Rule] 是全设备生效、不区分 App，所以这里只能放行。
# 豆瓣的穿山甲广告素材改由 erebor/feed_ad 与列表接口脚本过滤，不靠封 CDN。

# 京东广告 SDK / 京准通
DOMAIN, dsp-x.jd.com, REJECT
DOMAIN, janapi.jd.com, REJECT
DOMAIN, xlog.jd.com, REJECT
DOMAIN, knicks.jd.com, REJECT
# mapi.m.jd.com 是京东 App 的主 API 网关，不是京准通广告域，封了会让京东 App 打不开
DOMAIN-SUFFIX, jzt.jd.com, REJECT
DOMAIN-SUFFIX, orbit.jd.com, REJECT

# 淘宝 / 阿里
DOMAIN, baichuan-sdk.taobao.com, REJECT
DOMAIN, baichuan-sdk.alicdn.com, REJECT
DOMAIN-SUFFIX, tanx.com, REJECT
DOMAIN-SUFFIX, alimama.com, REJECT

# 快手联盟
DOMAIN-SUFFIX, open.e.kuaishou.com, REJECT
DOMAIN-SUFFIX, kuaishouzt.com, REJECT

# 百度联盟
DOMAIN-SUFFIX, mobads.baidu.com, REJECT
DOMAIN-SUFFIX, mobads-logs.baidu.com, REJECT
DOMAIN-SUFFIX, cpro.baidu.com, REJECT

[Rewrite]
# 开屏竞价位：splash_bid / splash_show / splash_config，返回 200 + {}
^https?:\/\/api\.douban\.com\/v2\/app_ads\/splash\w+ reject-dict

# 旧版开屏与通用广告位
^https?:\/\/api\.douban\.com\/v\d\/app_ads\/ reject-dict
^https?:\/\/api\.douban\.com\/b.*\/common_ads\?.* reject-dict

# 开屏素材：dale 主路径 + dale_ad/public 子路径，含 qnmob 系 CDN
^https?:\/\/(?:img|qnmob)3\.doubanio\.com\/view\/dale-online\/dale_ad\/public\/\w+ reject-dict
^https?:\/\/(?:img|qnmob)\d+\.doubanio\.com\/view\/dale-online\/dale_ad\/ reject

# 首页横幅 / 电影页横幅
^https?:\/\/frodo\.douban\.com\/api\/v2\/movie\/banner reject
^https?:\/\/frodo\.douban\.com\/api\/v2\/home_banner reject-dict

# 广告曝光上报
^https?:\/\/erebor\.douban\.com\/count\/\?ad= reject

[Script]
http-response ^https:\/\/frodo\.douban\.com\/api\/v2\/feature_switch script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/douban-feature.js, requires-body=true, timeout=60
http-response ^https?:\/\/amonsul\.douban\.com\/check2 script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/s2.js, requires-body=true, timeout=60
http-response ^https?:\/\/frodo\.douban\.com\/api\/v2\/erebor\/feed_ad script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/feed-ad.js, requires-body=true, timeout=60
http-response ^https?:\/\/frodo\.douban\.com\/api\/v2\/(?:group\/\d+\/topics|group\/topic\/\d+(?:\?|$)|elendil\/recommend_feed) script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/list-ad.js, requires-body=true, timeout=60

[MITM]
hostname = api.douban.com, frodo.douban.com, amonsul.douban.com, img*.doubanio.com, qnmob*.doubanio.com, img*.douban.com, erebor.douban.com
