#!name=豆瓣去广告（安全版）
#!desc=v3 降风险版：MITM 只留 frodo 一个域名，脚本只改 4 个广告接口，登录/账号链路完全不碰。开屏四件套走策略层 REJECT-DICT 回 {}，优量汇素材 CDN 断供。看到这行文字说明你装的是 v3。
#!author=SydawN
#!homepage=https://github.com/SydawN/loon
#!raw-url=https://github.com/SydawN/loon/raw/main/douban-ad.plugin
#!icon=https://www.douban.com/favicon.ico
#!category=SydawN 的插件
#!tag = 去广告, 豆瓣
#!date=2026-11-22 17:10:00
#!version=3

[Rule]
# ============ 豆瓣自有广告系统 Dale ============
# erebor 是豆瓣的广告投放域名，只服务广告，拦掉安全
DOMAIN, erebor.douban.com, REJECT
# 开屏四件套：在策略层直接回 {}，不依赖 MITM 解密。
# api.douban.com 同时承载账号/登录类接口，为降低风险本版不再对它开启 MITM，
# 这是「登录不上」最可能的关联点。
URL-REGEX, ^https://api\.douban\.com/v2/app_ads/, REJECT-DICT
# 广告图在 doubanio 的 dale-online 路径下。这里用 REJECT-IMG 而不是 REJECT：
# REJECT 回 404，图片加载失败会让 App 认为 CDN 出问题；
# REJECT-IMG 回 200 + 1×1 像素，App 当正常的空图，广告位显示空白而不报错
URL-REGEX, ^https://img\d+\.doubanio\.com/view/dale-online/, REJECT-IMG

# ============ 广告联盟入口 ============
# 穿山甲（豆瓣 site_id 5003518）
DOMAIN-SUFFIX, pangle.io, REJECT
DOMAIN-SUFFIX, gromore.cn, REJECT
DOMAIN-SUFFIX, oceanengine.com, REJECT
DOMAIN, webcast-open.douyin.com, REJECT

# 优量汇 / 腾讯广告（豆瓣 app id 1106295950）
DOMAIN-SUFFIX, gdt.qq.com, REJECT
DOMAIN-SUFFIX, pgdt.gtimg.cn, REJECT-IMG
# 优量汇的开屏素材就是从这个 CDN 下的。85 号包证明 App 会把下载过的创意缓存在本地，
# 之后再也不联网也能开屏——所以这里用 REJECT-IMG 断掉素材下载，让缓存清空后不再回填
URL-REGEX, ^https://pgdt\.ugdtimg\.com/, REJECT-IMG
DOMAIN-SUFFIX, adsmogo.com, REJECT

# 快手联盟
DOMAIN-SUFFIX, open.e.kuaishou.com, REJECT
DOMAIN-SUFFIX, kuaishouzt.com, REJECT

# 百度联盟
URL-REGEX, ^http://m\.baidu\.com/baidu\.php, REJECT
DOMAIN-SUFFIX, mobads.baidu.com, REJECT
DOMAIN-SUFFIX, mobads-logs.baidu.com, REJECT
DOMAIN-SUFFIX, cpro.baidu.com, REJECT
DOMAIN-SUFFIX, pos.baidu.com, REJECT

# 京东京准通
DOMAIN-SUFFIX, jzt.jd.com, REJECT
DOMAIN-SUFFIX, orbit.jd.com, REJECT

# 阿里妈妈
DOMAIN-SUFFIX, tanx.com, REJECT
DOMAIN-SUFFIX, alimama.com, REJECT

[Script]
# 豆瓣广告位应答改写。结构全部来自 14 号包实测
http-response ^https://frodo\.douban\.com/api/v2/(home_ads|home_banner|erebor/feed_ad|group/[0-9]+/ad) script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/douban-ad.js, requires-body=true, timeout=30, tag=豆瓣广告位
# 说明：amonsul（广告总开关）本版不改写、不拦截、不开 MITM，原样放行

[MITM]
# 只开这一个。image CDN（img1~9.doubanio.com）绝对不能加进来：
# 它们承载的是头像和帖子配图本身，没有任何脚本要用，开了 MITM 只会让图片解密后加载失败，
# 这就是旧版「正常内容打不开」的主因。
hostname = frodo.douban.com

[End of file.]
