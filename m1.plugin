[Script]
s1 = type=http-response,pattern=^https://frodo\.douban\.com/api/v2/feature_switch,requires-body=1,max-size=131072,script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/s1.js
r1 = type=http-response,pattern=^https://ngabbs\.com/nuke\.php,requires-body=1,max-size=1048576,timeout=60,script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/nga-purge.js
r2 = type=http-response,pattern=^https://ngabbs\.com/app_api\.php,requires-body=1,max-size=1048576,timeout=30,script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/nga-adfree.js
r3 = type=http-response,pattern=^https://g1\.tagtic\.cn/,requires-body=1,max-size=1048576,timeout=30,script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/tagtic.js
r4 = type=http-response,pattern=^https://api-access\.pangolin-sdk-toutiao\.com/api/ad/union/mediation,requires-body=1,max-size=1048576,timeout=60,script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/adsense.js
r5 = type=http-response,pattern=^https://is\.snssdk\.com/api/ad/union/sdk,requires-body=1,max-size=1048576,timeout=60,script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/adsense.js
r6 = type=http-response,pattern=^https://mi\.gdt\.qq\.com/,requires-body=1,max-size=1048576,timeout=60,script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/adsense.js
r7 = type=http-response,pattern=^https://open\.e\.kuaishou\.com/rest/e/v3/open/univ,requires-body=1,max-size=1048576,timeout=60,script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/adsense.js

[MITM]
hostname = ngabbs.com, api-access.pangolin-sdk-toutiao.com, is.snssdk.com, mi.gdt.qq.com, open.e.kuaishou.com, g1.tagtic.cn, frodo.douban.com
