#!name=NGA 网页版去广告
#!desc=删除 NGA 网页版广告模块（Safari 用，不影响 App）。仅改写广告引擎 JS，不碰图片，帖子附件图正常显示。
#!author=SydawN
#!homepage=https://github.com/SydawN/loon

[Rule]
# NGA 网页广告素材走第三方 CDN 的部分
DOMAIN-SUFFIX, 66mobi.com, REJECT
DOMAIN-SUFFIX, gdt.qq.com, REJECT
DOMAIN-SUFFIX, e.qq.com, REJECT
DOMAIN-SUFFIX, gdtimg.com, REJECT
DOMAIN-SUFFIX, mobads.baidu.com, REJECT
DOMAIN-SUFFIX, pos.baidu.com, REJECT
DOMAIN-SUFFIX, cpro.baidu.com, REJECT
DOMAIN-SUFFIX, tanx.com, REJECT
DOMAIN-SUFFIX, alimama.com, REJECT

[Script]
# 三个广告引擎 JS 入口全部打空
http-response ^https://img4\.nga\.cn/app_res/sync/.*\.js script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/nga-web.js, requires-body=true, timeout=30, tag=NGA网页广告模块删除

[MITM]
hostname = img4.nga.cn
