#!name=NGA 清空开屏配置
#!desc=只清空 intro001（开屏广告配置）与 EXTRA_ADS_RULES（广告位清单），不拦截接口本身。开屏那条 type=com.dn 的广告素材在 NGA 自有图床，不走任何广告联盟，只能从配置层摘掉。
#!author=SydawN
#!homepage=https://github.com/SydawN/loon
#!raw-url=https://github.com/SydawN/loon/raw/main/nga-purge.plugin
#!icon=https://img.nga.cn/favicon.ico
#!category=SydawN 的插件
#!tag = 去广告, NGA
#!date=2026-11-22 14:55:00

[Script]
# 只改响应体，不做 REJECT
# 之前用 [Rewrite] reject 会让 App 回退到缓存里的旧 intro001，开屏广告反而保住
http-response ^https://ngabbs\.com/nuke\.php script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/nga-purge.js, requires-body=true, timeout=60, tag=NGA清空开屏配置

[MITM]
hostname = ngabbs.com

[End of file.]
