#!name=NGA 广告位断供
#!desc=让 App 认为「广告配置接口不可用」，从而不初始化广告 SDK。断网实测广告不出现，本插件就是模拟这个状态。若 App 图片或帖子页异常，停用本插件即可恢复。
#!author=SydawN
#!homepage=https://github.com/SydawN/loon
#!raw-url=https://github.com/SydawN/loon/raw/main/nga-purge.plugin
#!icon=https://img.nga.cn/favicon.ico
#!category=SydawN 的插件
#!tag = 去广告, NGA
#!date=2026-11-22 14:25:00

[Rewrite]
# 核心：直接把广告配置接口打成 404，模拟「断网」状态
# 断网实测（43 号 HAR）：App 只发自有接口请求、全部失败、广告完全不出现
# 说明 App 拿不到静态配置时不会回退到内置默认广告位
^https://ngabbs\.com/nuke\.php\?__lib=app_inter&__act=static_file_list reject

[Script]
# 附带清空首页运营位（配置接口已被 reject，这段只处理其余三个 action）
http-response ^https://ngabbs\.com/nuke\.php script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/nga-purge.js, requires-body=true, timeout=60, tag=NGA清空首页运营位

[MITM]
hostname = ngabbs.com

[End of file.]
