#!name=NGA 去广告（精简加速版）
#!desc=只保留抓包实测过的必要规则。启动加速改走策略层 REJECT-DICT（本地返回 200+空对象，完全不出网，0ms）——这是 Loon 唯一能绕过网络的手段；http-request 脚本只能修改请求、不能构造响应，之前那套写法在 Loon 里不执行，已移除。
#!author=SydawN
#!homepage=https://github.com/SydawN/loon
#!raw-url=https://github.com/SydawN/loon/raw/main/nga.plugin
#!icon=https://img.nga.cn/favicon.ico
#!category=SydawN 的插件
#!tag = 去广告, NGA
#!date=2026-11-22 15:52:00

[Rule]
# ============ 第一层：策略层本地返回（0ms，不出网）============
# 用 REJECT-DICT 而不是脚本。Loon 的 http-request 脚本只能改请求头/Body，
# 不能 $done({response}) 造响应（官方文档 http-request 段只列 $request 对象），写了也不执行。
# 策略层在路由阶段就决定，连连接都不建立。
# 实测被吃掉的时间：stats/batch 8 次×130ms、get_ads 841ms、settings 341+320ms、
# 快手 config 148ms → 合计约 2000ms
URL-REGEX, ^https://api-access\.pangolin-sdk-toutiao\.com/api/ad/union/sdk/stats, REJECT-DICT
URL-REGEX, ^https://api-access\.pangolin-sdk-toutiao\.com/api/ad/union/sdk/(get_ads|settings), REJECT-DICT
URL-REGEX, ^https://open\.e\.kuaishou\.com/rest/e/v3/open/(config|logBatch), REJECT-DICT

# ============ 第二层：必须放行给脚本改应答（排在所有 REJECT 之前）============
# 这几条若被下面任何后缀规则抢先拦掉，脚本就永远不会执行（这坑踩过两次）
# 为什么不用 REJECT-DICT：优量汇要看到 ret=102006、快手要看到 result=40003 这类
# 专有「无填充」码；空对象 {} 会被判成参数错误而触发重试，比放行更慢
DOMAIN, mi.gdt.qq.com, DIRECT
DOMAIN, open.e.kuaishou.com, DIRECT
DOMAIN, is.snssdk.com, DIRECT
DOMAIN, api-access.pangolin-sdk-toutiao.com, DIRECT

# ============ 第三层：加密 SDK，改不动只能拦 ============
# 一号联盟加密二进制包（实测 3594~8096 字节），66 号包复现过
DOMAIN, sdk.1rtb.net, REJECT-DICT
DOMAIN-SUFFIX, 1rtb.net, REJECT-DICT

# ============ 第四层：广告联盟入口 ============
# 穿山甲 / 巨量引擎（NGA aid=5000546）
DOMAIN-SUFFIX, pangle.io, REJECT
DOMAIN-SUFFIX, gromore.cn, REJECT
DOMAIN-SUFFIX, oceanengine.com, REJECT
DOMAIN-SUFFIX, pglstatp-toutiao.com, REJECT
DOMAIN-SUFFIX, douyinstatic.com, REJECT
DOMAIN-SUFFIX, ad.toutiao.com, REJECT
DOMAIN-SUFFIX, ibytedtos.com, REJECT

# 优量汇 / 腾讯广告
DOMAIN, e.qq.com, REJECT
DOMAIN-SUFFIX, pgdt.gtimg.cn, REJECT
DOMAIN-SUFFIX, adsmogo.com, REJECT
DOMAIN, tid.m.qq.com, REJECT
DOMAIN, tdid.m.qq.com, REJECT
DOMAIN-SUFFIX, i.gtimg.cn, REJECT

# 快手联盟
DOMAIN-SUFFIX, kuaishouzt.com, REJECT
DOMAIN-SUFFIX, ad.partner.gifshow.com, REJECT

# mobrtb（开屏素材 720×1280）
DOMAIN-SUFFIX, mobrtb.com, REJECT
DOMAIN-SUFFIX, 52qumao.com, REJECT
DOMAIN-SUFFIX, microengine.cn, REJECT

# 亿典广告平台（开屏曝光上报 api.ocpx.ydmob.com）
DOMAIN-SUFFIX, ydmob.com, REJECT

# 京东京准通 / 开普勒
DOMAIN-SUFFIX, jzt.jd.com, REJECT
DOMAIN-SUFFIX, dg.k.jd.com, REJECT
DOMAIN-SUFFIX, orbit.jd.com, REJECT

# 阿里妈妈
DOMAIN-SUFFIX, tanx.com, REJECT
DOMAIN-SUFFIX, alimama.com, REJECT
DOMAIN-SUFFIX, mmstat.com, REJECT

# 百度联盟（只留 4 条核心，cpro/dup/nsclick 等长尾已从抓包里消失）
URL-REGEX, ^http://m\.baidu\.com/baidu\.php, REJECT
DOMAIN-SUFFIX, mobads.baidu.com, REJECT
DOMAIN-SUFFIX, cpro.baidu.com, REJECT
DOMAIN-SUFFIX, cpro.baidustatic.com, REJECT

# 美团广告曝光监测（campaign_name=美食-必吃榜）
DOMAIN-SUFFIX, apimobile.meituan.com, REJECT

# 滴滴广告点击上报（快手渠道，UA=kwai-ios）
DOMAIN, gungnir.xiaojukeji.com, REJECT

[Script]
# ---- 开屏配置：改成「过期窗口 + 假素材」----
# 实测 intro001 返回空数组会让 App 回退内置默认开屏（这才是开屏清不掉的根因）
# 所以给 type=com.dn 的假配置指向 427 字节小图，App 走完开屏流程但画面几乎空白
# EXTRA_ADS_RULES 同理：清成 [] 会被当「无配置」回退默认，改成 start/end 均为 0 的过期窗口才会被跳过
http-response ^https://ngabbs\.com/nuke\.php script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/nga-purge.js, requires-body=true, timeout=60, tag=NGA广告位改写

# ---- adfree 字段伪装 ----
http-response ^https://ngabbs\.com/app_api\.php script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/nga-adfree.js, requires-body=true, timeout=30, tag=NGA伪装免广告

# ---- 三联盟「喂假数据」----
# 核心：无论原响应是 200/403/404，一律返回 200 + 标准「无填充」字段
# 404 会被 SDK 判成网络错误而降级播缓存，这就是之前拦得越干净广告越顽固的原因
http-response ^https://api-access\.pangolin-sdk-toutiao\.com/api/ad/union/mediation script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/adsense.js, requires-body=true, timeout=60, tag=穿山甲竞价无填充
http-response ^https://is\.snssdk\.com/api/ad/union/sdk script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/adsense.js, requires-body=true, timeout=60, tag=穿山甲无填充
http-response ^https://mi\.gdt\.qq\.com/ script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/adsense.js, requires-body=true, timeout=60, tag=优量汇无填充
http-response ^https://open\.e\.kuaishou\.com/rest/e/v3/open/univ script-path=https://raw.githubusercontent.com/SydawN/loon/main/scripts/adsense.js, requires-body=true, timeout=60, tag=快手联盟无填充

[MITM]
hostname = ngabbs.com, api-access.pangolin-sdk-toutiao.com, is.snssdk.com, mi.gdt.qq.com, open.e.kuaishou.com

[End of file.]
